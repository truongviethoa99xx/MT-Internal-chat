{
  "name": "mtm-chat",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @mtm/api prisma generate",
    "db:migrate": "pnpm --filter @mtm/api prisma migrate dev"
  }
}
